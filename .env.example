# Порт сервера
PORT=3000

# Пароль для входа в админку (/admin.html)
# ОБЯЗАТЕЛЬНО смените перед публикацией!
ADMIN_PASSWORD=admin123

# Секрет для сессионных токенов (любая длинная случайная строка)
SESSION_SECRET=change-me-to-random-string

# --- База данных (Turso / libSQL) ---
# Локально можно НЕ задавать: сервер сам создаст файл backend/data/site.db.
# На VPS для лендинга локального SQLite-файла достаточно. Если нужна managed-БД
# по сети — задайте оба значения:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# --- S3-хранилище медиа (Timeweb S3 или любое S3-совместимое) ---
# Если заданы ВСЕ четыре обязательных (ENDPOINT/BUCKET/ACCESS/SECRET) — медиа
# пишется в S3; иначе на локальный диск backend/uploads/ (как раньше).
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_REGION=ru-1
# S3_BUCKET=broadway-media
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_PUBLIC_BASE=https://s3.twcstorage.ru/broadway-media
